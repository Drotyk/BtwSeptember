NODE_ENV=development
BOT_TOKEN=replace_with_telegram_bot_token

POSTGRES_DB=btw
POSTGRES_USER=btw_app
POSTGRES_PASSWORD=replace_with_a_random_password
DATABASE_URL=postgresql://btw_app:replace_with_a_random_password@localhost:55433/btw

WEB_HOST=127.0.0.1
WEB_PORT=3000
SECURE_COOKIES=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_argon2id_hash_generated_by_npm_run_admin_hash

CHAT_INVITE_LINK=https://t.me/replace_with_chat_invite_link
PRIVACY_POLICY_URL=https://example.com/privacy
EVENT_RULES_URL=https://example.com/rules
PRIVACY_POLICY_VERSION=2026-01
EVENT_RULES_VERSION=2026-01

SESSION_TTL_SECONDS=1800
ADMIN_SESSION_TTL_SECONDS=3600
DROP_PENDING_UPDATES=false
